<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F7F4" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#EEF3EF" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#E7EDE8" />

    <!-- Navigation -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#17231D" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#253C30" /> 
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#2F8F67" /> 
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#2F3E35" />
    
    <SolidColorBrush x:Key="CaloriesBrush" Color="#E11D48" />
    <SolidColorBrush x:Key="ProteinsBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="FatsBrush" Color="#D97706" />
    <SolidColorBrush x:Key="CarbsBrush" Color="#059669" />

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#17211B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F6D65" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7D8881" />
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#F6FAF7" />
    <SolidColorBrush x:Key="TextOnDarkMutedBrush" Color="#AAB8AF" />

    <!-- Accent / semantic -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2F8F67" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#267956" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E1F1E9" />
    <SolidColorBrush x:Key="BlueBrush" Color="#4C7AD9" />
    <SolidColorBrush x:Key="BlueSoftBrush" Color="#E8EEFB" />
    <SolidColorBrush x:Key="AmberBrush" Color="#C9912B" />
    <SolidColorBrush x:Key="AmberSoftBrush" Color="#FBF0D8" />
    <SolidColorBrush x:Key="PurpleBrush" Color="#7B64C5" />
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#EEEAF9" />
    <SolidColorBrush x:Key="DangerBrush" Color="#CB4D4D" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#F8E5E5" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2F8F67" />
    <SolidColorBrush x:Key="WarningBrush" Color="#C9912B" />

    <!-- Lines / shadows -->
    <SolidColorBrush x:Key="BorderBrush" Color="#DEE6E0" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CFD9D1" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#8A152019" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#1A152019" />

    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">18</CornerRadius>
    
    <Thickness x:Key="PagePadding">28</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
</ResourceDictionary>