<Page x:Class="DietPlanner.Views.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="{DynamicResource Nav_Admin}">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource Admin_Title}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,4"/>
            <Button Content="{DynamicResource Btn_Back}" Command="{Binding BackCommand}" Padding="12,5" Margin="0,0,0,4"/>
        </WrapPanel>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="#DC2626" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <TabControl Grid.Row="2" IsEnabled="{Binding HasAdminAccess}" Background="Transparent" BorderThickness="0">
            <!-- Вкладка Користувачів -->
            <TabItem Header="{DynamicResource Admin_UsersTab}" Padding="12,6" FontWeight="SemiBold">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,10,0,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Content="{DynamicResource Admin_RefreshList}" Command="{Binding LoadUsersCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EAEAEA" RowHeight="38" Background="Transparent" BorderThickness="0" MinWidth="700">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Prof_DisplayName}" Binding="{Binding DisplayName}" Width="160"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                                    <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="100"/>
                                    <DataGridTextColumn Header="{DynamicResource Admin_RegDate}" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                                    <DataGridTemplateColumn Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <WrapPanel VerticalAlignment="Center">
                                                    <Button Content="{DynamicResource Admin_ChangeRole}" 
                                                            Command="{Binding DataContext.ToggleRoleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                            CommandParameter="{Binding}" Margin="0,2,6,2" Padding="8,4"/>
                                                    <Button Content="{DynamicResource Btn_Delete}" 
                                                            Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                            CommandParameter="{Binding}" Background="#DC2626" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="8,4" Cursor="Hand" Margin="0,2,0,2"/>
                                                </WrapPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Вкладка Логів -->
            <TabItem Header="{DynamicResource Admin_LogsTab}" Padding="12,6" FontWeight="SemiBold">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,10,0,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Content="{DynamicResource Admin_RefreshList}" Command="{Binding LoadLogsCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                        <TextBox Grid.Row="1" Text="{Binding LogsContent}" IsReadOnly="True" 
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                                 FontFamily="Consolas" FontSize="12" Background="#17231D" Foreground="#A2B2A8" Padding="12" BorderThickness="0" MinHeight="300"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Page>