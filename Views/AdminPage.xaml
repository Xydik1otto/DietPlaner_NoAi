<Page x:Class="DietPlanner.Views.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="{DynamicResource Nav_Admin}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="BrowserTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" 
                                Background="{StaticResource SurfaceSubtleBrush}" 
                                BorderBrush="Transparent"
                                BorderThickness="0,3,0,0" 
                                CornerRadius="10,10,0,0" 
                                Padding="{TemplateBinding Padding}" 
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrowserTabControlStyle" TargetType="TabControl">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource BrowserTabItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TabPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,0" Panel.ZIndex="1" Background="Transparent"/>
                            
                            <Border Grid.Row="1" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="{StaticResource PagePadding}" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ЗАГОЛОВОК СТОРІНКИ -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Admin_Title}" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="{DynamicResource Btn_Back}" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top" Padding="14,6" />
                </Grid>

                <!-- ОСНОВНИЙ TAB CONTROL З АВТО-ОНОВЛЕННЯМ ДАНИХ -->
                <TabControl x:Name="MainAdminTabControl" 
                            Grid.Row="2" 
                            IsEnabled="{Binding HasAdminAccess}" 
                            Style="{StaticResource BrowserTabControlStyle}"
                            SelectionChanged="MainAdminTabControl_SelectionChanged">
                    
                    <!-- ВКЛАДКА 1: СТАТИСТИКА ПЛАТФОРМИ -->
                    <TabItem Header="{DynamicResource Admin_TabStats}">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,0" Padding="20" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,10" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Картка 1: Усього користувачів -->
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceSubtleBrush}" CornerRadius="12" Padding="20">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="👥 " FontSize="14" />
                                                <TextBlock Text="{DynamicResource Admin_StatTotalUsers}" Foreground="{StaticResource TextMutedBrush}" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding TotalUsersCount}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Картка 2: Активні користувачі -->
                                    <Border Grid.Column="2" Background="{StaticResource SurfaceSubtleBrush}" CornerRadius="12" Padding="20">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="⚡ " FontSize="14" />
                                                <TextBlock Text="{DynamicResource Admin_StatActiveUsers}" Foreground="{StaticResource TextMutedBrush}" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ActiveUsersCount}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Картка 3: Сформовано раціонів -->
                                    <Border Grid.Column="4" Background="{StaticResource SurfaceSubtleBrush}" CornerRadius="12" Padding="20">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="📅 " FontSize="14" />
                                                <TextBlock Text="{DynamicResource Admin_StatTotalPlans}" Foreground="{StaticResource TextMutedBrush}" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding TotalPlansCount}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- ВКЛАДКА 2: КЕРУВАННЯ КОРИСТУВАЧАМИ -->
                    <TabItem Header="{DynamicResource Admin_TabUsers}">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,0" Padding="18" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                                    <Button Content="🔄 Оновити список" 
                                            Command="{Binding LoadUsersAndStatsCommand}" 
                                            Style="{StaticResource PrimaryButtonStyle}" 
                                            Padding="14,8" Margin="0,0,16,0" />

                                    <Border Background="{StaticResource SurfaceSubtleBrush}" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="👥 Всього користувачів у системі: " FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TotalUsersCount}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EAEAEA" RowHeight="42" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding ShortId}" Width="100" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                        <DataGridTextColumn Header="{DynamicResource Prof_DisplayName}" Binding="{Binding DisplayName}" Width="2*" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="3*" />
                                        <DataGridTextColumn Header="{DynamicResource Admin_Role}" Binding="{Binding RoleDisplayName}" Width="130" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="{DynamicResource Admin_RegDate}" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150" Foreground="{StaticResource TextMutedBrush}" />

                                        <DataGridTemplateColumn Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <Button Content="{DynamicResource Admin_ChangeRole}" 
                                                                Command="{Binding DataContext.ToggleRoleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                                CommandParameter="{Binding}" 
                                                                Style="{StaticResource SecondaryButtonStyle}" 
                                                                Padding="10,4" Margin="0,0,6,0" FontSize="11" />

                                                        <Button Content="{DynamicResource Admin_DeleteImmediate}" 
                                                                Command="{Binding DataContext.DeleteUserWithoutWarningCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                                CommandParameter="{Binding}" 
                                                                Background="#DC2626" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="10,4" FontSize="11" Cursor="Hand" />
                                                    </WrapPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- ВКЛАДКА 3: ЛОГИ СИСТЕМИ -->
                    <TabItem Header="{DynamicResource Admin_TabLogs}">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,0" Padding="18" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0" Content="🔄 Оновити логи" 
                                        Command="{Binding LoadLogsCommand}" 
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        HorizontalAlignment="Left" Margin="0,0,0,14" Padding="14,8" />

                                <TabControl Grid.Row="1" Style="{StaticResource BrowserTabControlStyle}" HorizontalAlignment="Stretch">
                                    <TabItem Header="{DynamicResource Admin_CriticalLogs}">
                                        <Border CornerRadius="10" Background="#1E0A0A" Padding="4" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                            <TextBox Text="{Binding CriticalLogsContent}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="Transparent" Foreground="#FCA5A5" BorderThickness="0" Padding="12" MinHeight="320" HorizontalAlignment="Stretch" />
                                        </Border>
                                    </TabItem>
                                    
                                    <TabItem Header="{DynamicResource Admin_UserLogs}">
                                        <Border CornerRadius="10" Background="#0F172A" Padding="4" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                            <TextBox Text="{Binding UserLogsContent}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Padding="12" MinHeight="320" HorizontalAlignment="Stretch" />
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- ВКЛАДКА 4: ГЛОБАЛЬНЕ СПОВІЩЕННЯ -->
                    <TabItem Header="{DynamicResource Admin_TabBroadcast}">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,0" Padding="20" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Stretch">
                                <TextBlock Text="{DynamicResource Admin_BroadcastHeader}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                
                                <Border Background="{StaticResource SurfaceSubtleBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding ActiveBroadcastStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                                </Border>

                                <TextBox Text="{Binding BroadcastText, UpdateSourceTrigger=PropertyChanged}" Height="120" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource AppTextBoxStyle}" Padding="12" Margin="0,0,0,20" HorizontalAlignment="Stretch" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource Admin_BroadcastSend}" Command="{Binding SendBroadcastCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="18,9" Margin="0,0,10,0" />
                                    <Button Content="{DynamicResource Admin_BroadcastClear}" Command="{Binding ClearBroadcastCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="16,9" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </ScrollViewer>
</Page>