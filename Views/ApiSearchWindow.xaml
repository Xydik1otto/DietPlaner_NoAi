<Window x:Class="DietPlanner.Views.ApiSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Онлайн-пошук продуктів (Open Food Facts)" 
        Height="540" Width="660"
        MinHeight="440" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Border Background="{StaticResource SurfaceBrush}" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="14" 
            Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="#152019" BlurRadius="18" ShadowDepth="4" Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Кастомний TitleBar у загальному стилі програми -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Основний контент -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Темна кастомна шапка (TitleBar) -->
            <Border Grid.Row="0" 
                    Background="{StaticResource SidebarBrush}" 
                    CornerRadius="13,13,0,0" 
                    Padding="16,6,8,6" 
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text="🌐 Онлайн-пошук продуктів (Open Food Facts)" 
                               Foreground="{StaticResource TextOnDarkBrush}" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               VerticalAlignment="Center"/>

                    <Button Content="✕" 
                            HorizontalAlignment="Right" 
                            Click="CloseButton_Click" 
                            Style="{StaticResource TitleBarCloseButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Основний контент вікна -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Шукайте брендовані товари та інгредієнти у глобальній базі даних:" 
                           FontSize="12" 
                           Foreground="{StaticResource TextMutedBrush}" 
                           Margin="0,0,0,12" 
                           TextWrapping="Wrap"/>

                <!-- Пошуковий рядок -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             Text="{Binding ApiSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource AppTextBoxStyle}" 
                             Padding="8" 
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="1" 
                            Content="🔍 Шукати" 
                            Command="{Binding SearchApiCommand}" 
                            IsEnabled="{Binding IsNotApiLoading}" 
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>

                <!-- Індикатор завантаження та статус -->
                <StackPanel Grid.Row="2">
                    <ProgressBar IsIndeterminate="True" 
                                 Height="3" 
                                 Margin="0,0,0,6" 
                                 Visibility="{Binding IsApiLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding ApiStatusMessage}" 
                               FontSize="12" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               Margin="0,0,0,8" 
                               FontWeight="Medium" 
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Таблиця даних -->
                <DataGrid Grid.Row="3" 
                          ItemsSource="{Binding ApiSearchResults}" 
                          SelectedItem="{Binding SelectedApiProduct}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          Margin="0,0,0,14" 
                          Background="Transparent" 
                          BorderThickness="1" 
                          BorderBrush="{StaticResource BorderBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Назва / Бренд" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Ккал / 100г" Binding="{Binding Calories, StringFormat={}{0:F0}}" Width="100"/>
                        <DataGridTextColumn Header="Б" Binding="{Binding Proteins, StringFormat={}{0:F1}}" Width="60"/>
                        <DataGridTextColumn Header="Ж" Binding="{Binding Fats, StringFormat={}{0:F1}}" Width="60"/>
                        <DataGridTextColumn Header="В" Binding="{Binding Carbs, StringFormat={}{0:F1}}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Кнопки дій -->
                <WrapPanel Grid.Row="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Btn_Cancel}" 
                            Click="CloseButton_Click" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,0,8,0"/>
                    <Button Content="➕ Зберегти в локальний каталог" 
                            Command="{Binding ImportApiProductCommand}" 
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                            IsEnabled="{Binding IsNotApiLoading}" 
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</Window>