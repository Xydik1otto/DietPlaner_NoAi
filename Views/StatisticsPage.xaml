<Page x:Class="DietPlanner.Views.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="{DynamicResource Nav_Statistics}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="{StaticResource PagePadding}" MaxWidth="1000" HorizontalAlignment="Left">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="{DynamicResource Stat_PageTitle}" Style="{StaticResource PageTitleTextStyle}"/>
                    <TextBlock Text="{DynamicResource Stat_PageSubtitle}" 
                               Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,16">
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                            <RadioButton Content="{DynamicResource Stat_ModeDay}" IsChecked="{Binding IsDayMode, Mode=TwoWay}" 
                                         Style="{StaticResource NavRadioButtonStyle}" Padding="12,6" Margin="0,0,4,0"/>
                            <RadioButton Content="{DynamicResource Stat_ModeWeek}" IsChecked="{Binding IsWeekMode, Mode=TwoWay}" 
                                         Style="{StaticResource NavRadioButtonStyle}" Padding="12,6" Margin="0,0,4,0"/>
                            <RadioButton Content="{DynamicResource Stat_ModeMonth}" IsChecked="{Binding IsMonthMode, Mode=TwoWay}" 
                                         Style="{StaticResource NavRadioButtonStyle}" Padding="12,6"/>
                        </StackPanel>

                        <Border Width="1" Height="28" Background="{StaticResource BorderBrush}" Margin="0,0,24,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                            <TextBlock Text="{DynamicResource Stat_MonthLabel}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding MonthsList}" SelectedItem="{Binding SelectedMonth}" Style="{StaticResource AppComboBoxStyle}" Width="130" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding YearsList}" SelectedItem="{Binding SelectedYear}" Style="{StaticResource AppComboBoxStyle}" Width="90"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,8,8" 
                                    Visibility="{Binding IsDayMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource Stat_DateLabel}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Style="{StaticResource AppDatePickerStyle}" Width="150"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,8,8" 
                                    Visibility="{Binding IsWeekMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource Stat_WeekLabel}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding WeeksList}" 
                                      SelectedItem="{Binding SelectedWeek}" 
                                      DisplayMemberPath="DisplayName" 
                                      Style="{StaticResource AppComboBoxStyle}" 
                                      Width="200"/>
                        </StackPanel>

                        <Button Content="{DynamicResource Btn_Show}" Command="{Binding RefreshStatsCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,8" VerticalAlignment="Center"/>
                    </WrapPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dash_Calories}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalCaloriesText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CaloriesBrush}" Margin="0,6,0,2"/>
                            <TextBlock Text="{Binding CalorieGoalDiffText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ProgressBar Value="{Binding CalorieProgressPercent}" Maximum="100" Height="6" Margin="0,8,0,0" Foreground="{StaticResource CaloriesBrush}" Background="{StaticResource SurfaceSubtleBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dash_Proteins}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalProteinsText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ProteinsBrush}" Margin="0,6,0,2"/>
                            <TextBlock Text="{Binding ProteinGoalText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ProgressBar Value="{Binding ProteinProgressPercent}" Maximum="100" Height="6" Margin="0,8,0,0" Foreground="{StaticResource ProteinsBrush}" Background="{StaticResource SurfaceSubtleBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dash_Fats}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalFatsText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource FatsBrush}" Margin="0,6,0,2"/>
                            <TextBlock Text="{Binding FatGoalText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ProgressBar Value="{Binding FatProgressPercent}" Maximum="100" Height="6" Margin="0,8,0,0" Foreground="{StaticResource FatsBrush}" Background="{StaticResource SurfaceSubtleBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Dash_Carbs}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalCarbsText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CarbsBrush}" Margin="0,6,0,2"/>
                            <TextBlock Text="{Binding CarbGoalText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ProgressBar Value="{Binding CarbProgressPercent}" Maximum="100" Height="6" Margin="0,8,0,0" Foreground="{StaticResource CarbsBrush}" Background="{StaticResource SurfaceSubtleBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding PeriodTableTitle}" FontSize="15" FontWeight="Bold" Margin="16,14,16,10" Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <DataGrid ItemsSource="{Binding DailyBreakdownList}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="250">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Stat_ColDateDay}" Binding="{Binding DateDisplay}" Width="140"/>
                                <DataGridTextColumn Header="{DynamicResource Cat_Calories}" Binding="{Binding Calories, StringFormat={}{0:F0}}" Width="120"/>
                                <DataGridTextColumn Header="{DynamicResource Cat_Proteins}" Binding="{Binding Proteins, StringFormat={}{0:F1}}" Width="100"/>
                                <DataGridTextColumn Header="{DynamicResource Cat_Fats}" Binding="{Binding Fats, StringFormat={}{0:F1}}" Width="100"/>
                                <DataGridTextColumn Header="{DynamicResource Cat_Carbs}" Binding="{Binding Carbs, StringFormat={}{0:F1}}" Width="110"/>
                                <DataGridTextColumn Header="{DynamicResource Stat_ColGoalStatus}" Binding="{Binding GoalCompletionStatus}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </ScrollViewer>
</Page>