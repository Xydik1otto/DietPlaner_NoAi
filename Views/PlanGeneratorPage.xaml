<Page x:Class="DietPlanner.Views.PlanGeneratorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="{DynamicResource Nav_PlanGenerator}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="{DynamicResource Nav_PlanGenerator}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Автоматичне формування раціону на день або тиждень на основі параметрів вашого профілю." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Параметри генерації та Профіль -->
            <Grid Grid.Row="1" Margin="0,16,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Параметри генерації -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="⚙️ Налаштування генерації" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Оберіть кількість прийомів їжі та формат розрахунку." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,14" />

                        <WrapPanel VerticalAlignment="Bottom">
                            <!-- Кількість прийомів їжі -->
                            <StackPanel Width="140" Margin="0,0,16,12">
                                <TextBlock Text="Прийомів на день:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding MealCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Padding="8" />
                            </StackPanel>

                            <!-- Розрахований діапазон калорій (READ-ONLY) -->
                            <StackPanel Width="210" Margin="0,0,16,12">
                                <TextBlock Text="Добова ціль (з профілю):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <TextBlock Text="{Binding CalorieRangeText}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="13"/>
                                </Border>
                            </StackPanel>
                        </WrapPanel>

                        <!-- Кнопки дій -->
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="⚡ Згенерувати на день" Command="{Binding GenerateDayPlanCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="16,10" Margin="0,0,10,8" />
                            <Button Content="📅 Згенерувати на тиждень (7 днів)" Command="{Binding GenerateWeekPlanCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="16,10" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Інформаційний Блок Профілю -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Background="{StaticResource SurfaceSubtleBrush}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="📋 Дані вашого профілю" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding UserSummaryInfo}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="18" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Історія та вибір раціону -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,14">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,8" MinWidth="220">
                        <TextBlock Text="🍱 Сформовані раціони" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding GenerationResultSummary}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <ComboBox ItemsSource="{Binding PlanHistory}" SelectedItem="{Binding SelectedHistoryPlan}" Width="300" Style="{StaticResource AppComboBoxStyle}" Margin="0,0,0,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PlanDate, Mode=OneWay, StringFormat='План на {0:dd.MM.yyyy}'}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </WrapPanel>
            </Border>

            <!-- Таблиця слотів харчування -->
            <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="12">
                <DataGrid ItemsSource="{Binding GeneratedSlots}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EAEAEA" RowHeight="40" Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Слот" Binding="{Binding SlotName}" Width="130" />
                        <DataGridTextColumn Header="Страва / Рекомендація" Binding="{Binding SuggestedItemName}" Width="*" />
                        <DataGridTextColumn Header="Порція" Binding="{Binding PortionGrams, StringFormat={}{0:F0} г}" Width="90" />
                        <DataGridTextColumn Header="Ккал" Binding="{Binding Calories, StringFormat={}{0:F0}}" Width="80" />
                        <DataGridTextColumn Header="Б" Binding="{Binding Proteins, StringFormat={}{0:F1}}" Width="65" />
                        <DataGridTextColumn Header="Ж" Binding="{Binding Fats, StringFormat={}{0:F1}}" Width="65" />
                        <DataGridTextColumn Header="В" Binding="{Binding Carbs, StringFormat={}{0:F1}}" Width="65" />
                        <DataGridTemplateColumn Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🔄 Замінити" 
                                            Command="{Binding DataContext.OpenReplaceDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}" 
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Padding="8,4" FontSize="11" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- МОДАЛЬНЕ ВІКНО ЗАМІНИ -->
            <Grid Grid.RowSpan="4" Background="{StaticResource OverlayBrush}" Visibility="{Binding IsReplaceDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="24" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Заміна страви у раціоні" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <TextBlock Text="Слот:" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding SelectedSlotToReplace.SlotName}" FontSize="14" FontWeight="Bold" Margin="0,2,0,12"/>

                        <TextBlock Text="Оберіть заміну з каталогу:" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <ComboBox ItemsSource="{Binding AvailableReplacementItems}" SelectedItem="{Binding SelectedReplacementItem}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" Margin="0,4,0,12"/>

                        <TextBlock Text="Порція (грами):" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding ReplacePortionGramsInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Padding="8" Margin="0,4,0,20"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource Btn_Cancel}" Command="{Binding CloseReplaceDialogCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource Btn_Save}" Command="{Binding SaveReplaceSlotCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>