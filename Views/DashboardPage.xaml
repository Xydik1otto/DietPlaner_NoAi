<Page x:Class="DietPlanner.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="{DynamicResource Nav_Dashboard}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 0. БАННЕРИ -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <Border Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}" 
                        Background="{StaticResource AccentSoftBrush}" 
                        BorderBrush="{StaticResource AccentBrush}" 
                        BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="13"/>
                </Border>

                <Border Visibility="{Binding HasMacroWarning, Converter={StaticResource BoolToVisibilityConverter}}" 
                        Background="#FFFDF6E6" 
                        BorderBrush="#FFE5A93C" 
                        BorderThickness="1" CornerRadius="10" Padding="14,10">
                    <TextBlock Text="{Binding MacroWarningMessage}" Foreground="#FFB26B00" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <!-- 1. КАРТКИ КБЖУ -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🔥 " FontSize="12"/>
                            <TextBlock Text="{DynamicResource Dash_Calories}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CaloriesDisplay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CaloriesBrush}" Margin="0,4,0,4"/>
                        <ProgressBar Value="{Binding CurrentCalories}" Maximum="{Binding TargetCalories}" Height="6" Foreground="{StaticResource CaloriesBrush}" Background="{StaticResource SurfaceSubtleBrush}" BorderThickness="0" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🥩 " FontSize="12"/>
                            <TextBlock Text="{DynamicResource Dash_Proteins}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ProteinsDisplay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ProteinsBrush}" Margin="0,4,0,4"/>
                        <ProgressBar Value="{Binding CurrentProteins}" Maximum="{Binding TargetProteins}" Height="6" Foreground="{StaticResource ProteinsBrush}" Background="{StaticResource SurfaceSubtleBrush}" BorderThickness="0" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🥑 " FontSize="12"/>
                            <TextBlock Text="{DynamicResource Dash_Fats}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding FatsDisplay}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource FatsBrush}" Margin="0,4,0,4"/>
                        <ProgressBar Value="{Binding CurrentFats}" Maximum="{Binding TargetFats}" Height="6" Foreground="{StaticResource FatsBrush}" Background="{StaticResource SurfaceSubtleBrush}" BorderThickness="0" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🌾 " FontSize="12"/>
                            <TextBlock Text="{DynamicResource Dash_Carbs}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CarbsDisplay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CarbsBrush}" Margin="0,4,0,4"/>
                        <ProgressBar Value="{Binding CurrentCarbs}" Maximum="{Binding TargetCarbs}" Height="6" Foreground="{StaticResource CarbsBrush}" Background="{StaticResource SurfaceSubtleBrush}" BorderThickness="0" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. ВОДНИЙ БАЛАНС -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="💧" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Dash_WaterBalance}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="{Binding WaterDrankLiters, Mode=OneWay, StringFormat={}{0:F2}}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding WaterTargetLiters, Mode=OneWay, StringFormat={}{0:F1}}"/>
                                <Run Text=" "/>
                                <Run Text="{DynamicResource Dash_WaterLiters}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <ProgressBar Grid.Column="1" Value="{Binding WaterDrankLiters}" Maximum="{Binding WaterTargetLiters}" Height="10" Foreground="{StaticResource BlueBrush}" Background="{StaticResource SurfaceSubtleBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>

                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Content="{DynamicResource Dash_Add250ml}" Command="{Binding AddWaterCommand}" CommandParameter="0.25" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,6,0"/>
                        <Button Content="{DynamicResource Dash_Add500ml}" Command="{Binding AddWaterCommand}" CommandParameter="0.5" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,6,0"/>
                        <Button Content="{DynamicResource Dash_WaterTargetBtn}" Command="{Binding OpenEditWaterTargetDialogCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,5" Margin="0,0,6,0"/>
                        <Button Content="{DynamicResource Dash_WaterResetBtn}" Command="{Binding ResetWaterCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,5" ToolTip="{DynamicResource Dash_WaterResetTip}"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- 3. ДІЇ -->
            <WrapPanel Grid.Row="3" Margin="0,0,0,18">
                <Button Content="{DynamicResource Dash_BtnAddMeal}" Command="{Binding AddMealCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8"/>
                <Button Content="{DynamicResource Dash_BtnSuggestMeal}" Command="{Binding SuggestMealCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8" Margin="0,0,8,8"/>
                <Button Content="{DynamicResource Dash_BtnExportReport}" Command="{Binding ExportReportCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8" Margin="0,0,8,8"/>
                <Button Content="{DynamicResource Dash_BtnUndo}" Command="{Binding UndoCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8" Margin="0,0,8,8"/>
            </WrapPanel>

            <!-- 4. ПЛАН ХАРЧУВАННЯ -->
            <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{DynamicResource Dash_MealPlanTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding AvailablePlans}" 
                                  SelectedItem="{Binding SelectedPlan, Mode=TwoWay}" 
                                  Width="280" 
                                  Style="{StaticResource AppComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{DynamicResource Dash_PlanPrefix}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding PlanDate, Mode=OneWay, StringFormat={}{0:dd.MM.yyyy}}"/>
                                        <Run Text=" ("/><Run Text="{Binding TargetCalories, Mode=OneWay, StringFormat={}{0:F0}}"/><Run Text=" "/>
                                        <Run Text="{DynamicResource Unit_Kcal}"/><Run Text=")"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    
                    <DataGrid ItemsSource="{Binding TodayPlanItems}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{DynamicResource Dash_ColEaten}" Width="Auto" MinWidth="64" HeaderStyle="{StaticResource GridHeaderCenter}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEaten, Mode=OneWay}"
                                                  Command="{Binding DataContext.TogglePlanItemEatenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{DynamicResource Dash_ColSlot}" Binding="{Binding MealName}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource GridTextCellSemi}"/>

                            <DataGridTemplateColumn Header="{DynamicResource Dash_ColItem}" Width="*" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ItemName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"/>
                                            <Border Visibility="{Binding IsMultiComponent, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{StaticResource AmberSoftBrush}"
                                                    CornerRadius="4" Padding="6,2" Margin="0,4,0,0"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding MultiComponentNote}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#8A5A00"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{DynamicResource Dash_ColPortion}" Binding="{Binding PortionGrams, StringFormat={}{0:F0} г}" Width="Auto" MinWidth="80" HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource GridNumCell}"/>
                            <DataGridTextColumn Header="{DynamicResource Dash_Calories}" Binding="{Binding Calories, StringFormat={}{0:F0}}" Width="Auto" MinWidth="80" HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource GridNumCellStrong}"/>
                            <DataGridTextColumn Header="{DynamicResource Dash_Proteins}" Binding="{Binding Proteins, StringFormat={}{0:F1}}" Width="Auto" MinWidth="70" HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource GridNumCell}"/>
                            <DataGridTextColumn Header="{DynamicResource Dash_Fats}" Binding="{Binding Fats, StringFormat={}{0:F1}}" Width="Auto" MinWidth="70" HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource GridNumCell}"/>
                            <DataGridTextColumn Header="{DynamicResource Dash_Carbs}" Binding="{Binding Carbs, StringFormat={}{0:F1}}" Width="Auto" MinWidth="90" HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource GridNumCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 5. ФАКТИЧНО З'ЇДЕНО -->
            <Border Grid.Row="5" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dash_ActualEatenTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                    <Border Visibility="{Binding HasNoEatenToday, Converter={StaticResource BoolToVisibilityConverter}}" Background="{StaticResource SurfaceSubtleBrush}" CornerRadius="10" Padding="28" Margin="0,4,0,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🍽️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="{DynamicResource Dash_NoEatenTitle}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Dash_NoEatenDesc}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Visibility="{Binding HasEatenToday, Converter={StaticResource BoolToVisibilityConverter}}" ItemsSource="{Binding TodayIntakes}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Dash_ColName}" Binding="{Binding ItemName}" Width="*" MinWidth="180" ElementStyle="{StaticResource GridTextCellSemi}"/>
                            <DataGridTextColumn Header="{DynamicResource Dash_ColTime}" Binding="{Binding IntakeTime, StringFormat={}{0:HH:mm}}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource GridTextCell}"/>
                            <DataGridTextColumn Header="{DynamicResource Dash_ColWeight}" Binding="{Binding WeightGrams, StringFormat={}{0:F0}}" Width="Auto" MinWidth="80" HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource GridNumCell}"/>
                            <DataGridTextColumn Header="{DynamicResource Dash_Calories}" Binding="{Binding Calories, StringFormat={}{0:F0}}" Width="Auto" MinWidth="80" HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource GridNumCellStrong}"/>
                            <DataGridTextColumn Header="{DynamicResource Dash_ColMacros}" Binding="{Binding NutritionSummary}" Width="Auto" MinWidth="140" ElementStyle="{StaticResource GridTextCell}"/>

                            <DataGridTemplateColumn Width="Auto" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{DynamicResource Btn_Delete}"
                                                Command="{Binding DataContext.DeleteIntakeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="8,4" FontSize="11" Foreground="#E53935" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- ДІАЛОГОВІ ВІКНА -->
            <Grid Grid.RowSpan="6" Background="{StaticResource OverlayBrush}" Visibility="{Binding IsAddMealDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dash_DlgAddMealTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="{DynamicResource Dash_DlgSelectFood}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableFoodItems}" SelectedItem="{Binding SelectedFoodItem}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource Dash_DlgPortionGrams}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PortionGramsInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Padding="8" Margin="0,0,0,20"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource Btn_Cancel}" Command="{Binding CloseAddMealDialogCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="{DynamicResource Btn_Save}" Command="{Binding SaveMealIntakeCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.RowSpan="6" Background="{StaticResource OverlayBrush}" Visibility="{Binding IsEditWaterTargetDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="24" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dash_DlgWaterTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource Dash_DlgWaterDesc}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14"/>
                        <TextBox Text="{Binding WaterTargetInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Padding="8" Margin="0,0,0,18"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource Btn_Cancel}" Command="{Binding CloseEditWaterTargetDialogCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource Btn_Save}" Command="{Binding SaveWaterTargetCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.RowSpan="6" Background="{StaticResource OverlayBrush}" Visibility="{Binding IsSuggestMealDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dash_DlgSuggestTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource Dash_DlgSuggestDesc}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <ListBox ItemsSource="{Binding SuggestedMealOptions}" SelectedItem="{Binding SelectedSuggestedMeal}" Height="220" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,14">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                        <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Calories, StringFormat={}{0:F0} ккал}" FontWeight="Bold" Foreground="{StaticResource CaloriesBrush}" HorizontalAlignment="Right"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="Б: "/><Run Text="{Binding Proteins, StringFormat={}{0:F1}}"/><Run Text="г | "/>
                                                <Run Text="Ж: "/><Run Text="{Binding Fats, StringFormat={}{0:F1}}"/><Run Text="г | "/>
                                                <Run Text="В: "/><Run Text="{Binding Carbs, StringFormat={}{0:F1}}"/><Run Text="г"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{DynamicResource Dash_DlgPortionGrams}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SuggestedPortionGramsInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Padding="8" Margin="0,0,0,20"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource Dash_BtnRefreshVariants}" Command="{Binding RefreshSuggestedMealsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="{DynamicResource Btn_Cancel}" Command="{Binding CloseSuggestMealDialogCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="{DynamicResource Dash_BtnAddToDiet}" Command="{Binding ConfirmSuggestMealCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>