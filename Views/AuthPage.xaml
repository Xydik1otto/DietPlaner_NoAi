<Page x:Class="DietPlanner.Views.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="clr-namespace:DietPlanner.Common"
      Title="Авторизація">

    <Page.Resources>
        <common:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Background="{StaticResource AppBackgroundBrush}" Padding="24">
            <!-- WrapPanel переносить карту входу під Brand Panel при малому екрані -->
            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" ItemWidth="NaN" ItemHeight="NaN">
                
                <!-- ЛІВА ПАНЕЛЬ (Brand Panel) -->
                <Border Background="{StaticResource SidebarBrush}" CornerRadius="24" Padding="32" Width="440" Margin="12">
                    <Grid MinHeight="420">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Заголовок та опис -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="DIETPLANNER" FontSize="12" FontWeight="Bold" Foreground="#8C9A91" />
                            <TextBlock Text="Плануй харчування.&#10;Розумій свій день." FontSize="32" FontWeight="SemiBold" Foreground="White" Margin="0,14,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Один простий простір для продуктів, прийомів їжі, КБЖУ та персонального плану." FontSize="14" Foreground="#A2B2A8" Margin="0,12,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Фічі з іконками -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20">
                            <Border Background="#24372C" CornerRadius="16" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" Background="#1E382B" CornerRadius="10">
                                        <TextBlock Text="К" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Контроль калорій" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Добова ціль і фактичне споживання" Foreground="#8C9A91" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="#24372C" CornerRadius="16" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" Background="#1E2B38" CornerRadius="10">
                                        <TextBlock Text="Б" Foreground="{StaticResource BlueBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="КБЖУ в одному місці" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Швидко бачиш, де знаходишся відносно цілі" Foreground="#8C9A91" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Персональні дані зберігаються локально у твоєму профілі." Foreground="#8C9A91" FontSize="11" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- ПРАВА ФОРМА (Auth Card) -->
                <Border Style="{StaticResource CardStyle}" Padding="28" CornerRadius="24" Width="400" Margin="12" VerticalAlignment="Center">
                    <StackPanel>
                        <Border Width="48" Height="48" Background="#E2F2E9" CornerRadius="14" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <TextBlock Text="🍃" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="{Binding ModeTitle}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Увійди, щоб продовжити роботу з персональним планом." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,16" TextWrapping="Wrap" />

                        <!-- Статус / Помилка -->
                        <Border Background="#FEE2E2" 
                                CornerRadius="10" 
                                Padding="10" 
                                Margin="0,0,0,14" 
                                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding StatusMessage}" 
                                       Foreground="#DC2626" 
                                       TextWrapping="Wrap" 
                                       FontSize="12" 
                                       FontWeight="Medium" />
                        </Border>

                        <TextBlock Text="Email" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,12" />

                        <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Ім'я та прізвище" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,12" />
                        </StackPanel>

                        <TextBlock Text="Пароль" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                        <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" Padding="8" Margin="0,0,0,12" />

                        <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Підтвердження пароля" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                            <PasswordBox x:Name="ConfirmPasswordBox" PasswordChanged="ConfirmPasswordBox_PasswordChanged" Padding="8" Margin="0,0,0,16" />
                        </StackPanel>

                        <Button Content="{Binding SubmitTitle}" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="10" />

                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" Foreground="{StaticResource AccentBrush}" />

                        <Button Content="{Binding SwitchTitle}" Command="{Binding ToggleModeCommand}" Background="Transparent" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>
    </ScrollViewer>
</Page>