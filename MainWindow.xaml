<Window x:Class="DietPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App_Title}"
        Height="760" Width="1200"
        MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource SidebarBrush}" BorderThickness="1" Background="{StaticResource AppBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ШАПКА ВІКНА -->
            <Grid Grid.Row="0" Background="{StaticResource SidebarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="🥗" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="DietPlanner" Foreground="{StaticResource TextOnDarkBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Click="MinimizeButton_Click" Style="{StaticResource TitleBarButtonStyle}" Content="─"/>
                    <Button Click="MaximizeButton_Click" x:Name="MaximizeBtn" Style="{StaticResource TitleBarButtonStyle}" Content="🗖"/>
                    <Button Click="CloseButton_Click" Style="{StaticResource TitleBarCloseButtonStyle}" Content="✕"/>
                </StackPanel>
            </Grid>

            <!-- ОСНОВНИЙ КОНТЕНТ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar (Бокове меню) -->
                <Border Grid.Column="0" Width="240" Background="{StaticResource SidebarBrush}" Padding="16,12,16,16"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                            <TextBlock Text="DIETPLANNER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextOnDarkMutedBrush}" />
                            <TextBlock Text="{DynamicResource App_SubTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextOnDarkBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding UserDisplayName}" FontSize="12" Foreground="{StaticResource TextOnDarkMutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            <Border Height="1" Background="{StaticResource SidebarDividerBrush}" Margin="0,14,0,10" />
                        </StackPanel>

                        <Button DockPanel.Dock="Bottom" Content="{DynamicResource Nav_Logout}" Command="{Binding LogoutCommand}" Style="{StaticResource NavButtonStyle}" Foreground="#FF8A8A" Margin="0,10,0,0" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel>
                                <RadioButton Content="{DynamicResource Nav_Dashboard}" Command="{Binding NavigateDashboardCommand}" 
                                             IsChecked="{Binding IsDashboardActive, Mode=OneWay}" GroupName="SidebarMenu" Style="{StaticResource NavRadioButtonStyle}" />

                                <RadioButton Content="{DynamicResource Nav_Catalog}" Command="{Binding NavigateCatalogCommand}" 
                                             IsChecked="{Binding IsCatalogActive, Mode=OneWay}" GroupName="SidebarMenu" Style="{StaticResource NavRadioButtonStyle}" />

                                <RadioButton Content="{DynamicResource Nav_PlanGenerator}" Command="{Binding NavigatePlanGeneratorCommand}" 
                                             IsChecked="{Binding IsPlanGeneratorActive, Mode=OneWay}" GroupName="SidebarMenu" Style="{StaticResource NavRadioButtonStyle}" />

                                <RadioButton Content="{DynamicResource Nav_Profile}" Command="{Binding NavigateProfileCommand}" 
                                             IsChecked="{Binding IsProfileActive, Mode=OneWay}" GroupName="SidebarMenu" Style="{StaticResource NavRadioButtonStyle}" />

                                <RadioButton Content="{DynamicResource Nav_Statistics}" Command="{Binding NavigateStatisticsCommand}" 
                                             IsChecked="{Binding IsStatisticsActive, Mode=OneWay}" GroupName="SidebarMenu" Style="{StaticResource NavRadioButtonStyle}" />
                                
                                <RadioButton Content="{DynamicResource Nav_UndoHistory}" Command="{Binding NavigateUndoHistoryCommand}" 
                                             IsChecked="{Binding IsUndoHistoryActive, Mode=OneWay}" GroupName="SidebarMenu" Style="{StaticResource NavRadioButtonStyle}" />

                                <RadioButton Content="{DynamicResource Nav_AdminPanel}" Command="{Binding NavigateAdminCommand}" 
                                             Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" 
                                             IsChecked="{Binding IsAdminActive, Mode=OneWay}" GroupName="SidebarMenu" 
                                             Style="{StaticResource NavRadioButtonStyle}" Foreground="#FBBF24" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Основний кадр -->
                <Grid Grid.Column="1">
                    <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" />

                    <!-- СТЕК ПЛАВАЮЧИХ СПОВІЩЕНЬ У ЛІВОМУ НИЖНЬОМУ КУТКУ -->
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,20" Panel.ZIndex="999" MaxWidth="420">
                        
                        <!-- 🚨 1. КРИТИЧНА ПОМИЛКА ДЛЯ АДМІНІСТРАТОРА (Червона) -->
                        <Border Margin="0,0,0,10"
                                Background="#7F1D1D" BorderBrush="#DC2626" BorderThickness="1"
                                CornerRadius="12" Padding="14,12"
                                Visibility="{Binding IsAdminCriticalErrorVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                            </Border.Effect>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="🚨" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Увага! Критичні помилки" FontSize="11" FontWeight="Bold" Foreground="#FCA5A5"/>
                                    <TextBlock Text="{Binding AdminCriticalErrorMessage}" FontSize="13" Foreground="#FEF2F2" TextWrapping="Wrap" Margin="0,2,8,0"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="✕" Command="{Binding DismissAdminCriticalErrorCommand}" 
                                        Foreground="#FCA5A5" Background="Transparent" BorderThickness="0" 
                                        FontSize="14" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Top" Padding="4,0"/>
                            </Grid>
                        </Border>

                        <!-- 📢 2. ГЛОБАЛЬНЕ СИСТЕМНЕ СПОВІЩЕННЯ (Темно-темно синя) -->
                        <Border Background="#1E293B" CornerRadius="12" Padding="14,12"
                                Visibility="{Binding IsBroadcastVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                            </Border.Effect>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="📢" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Системне сповіщення" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding BroadcastMessage}" FontSize="13" Foreground="#F8FAFC" TextWrapping="Wrap" Margin="0,2,8,0"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="✕" Command="{Binding DismissBroadcastCommand}" 
                                        Foreground="#94A3B8" Background="Transparent" BorderThickness="0" 
                                        FontSize="14" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Top" Padding="4,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>