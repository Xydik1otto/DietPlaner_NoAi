<Window x:Class="DietPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DietPlanner — Планувальник Харчування"
        Height="760" Width="1200"
        MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Тонка рамка 1px навколо всього вікна -->
    <Border BorderBrush="{StaticResource SidebarBrush}" BorderThickness="1" Background="{StaticResource AppBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Верхня панель (TitleBar) -->
                <RowDefinition Height="34"/>
                <!-- Основний контент -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- КАСТОМНА ВЕРХНЯ ШАПКА -->
            <Grid Grid.Row="0" Background="{StaticResource SidebarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Іконка та назва програми -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="🥗" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="DietPlanner" Foreground="{StaticResource TextOnDarkBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Кнопки управління вікном -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Click="MinimizeButton_Click" Style="{StaticResource TitleBarButtonStyle}" Content="─"/>
                    <Button Click="MaximizeButton_Click" x:Name="MaximizeBtn" Style="{StaticResource TitleBarButtonStyle}" Content="🗖"/>
                    <Button Click="CloseButton_Click" Style="{StaticResource TitleBarCloseButtonStyle}" Content="✕"/>
                </StackPanel>
            </Grid>

            <!-- ОСНОВНИЙ КОНТЕНТ (Shell / Sidebar + MainFrame) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Width="240" Background="{StaticResource SidebarBrush}" Padding="16,12,16,16"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                            <TextBlock Text="DIETPLANNER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextOnDarkMutedBrush}" />
                            <TextBlock Text="Ваш раціон під контролем" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextOnDarkBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding UserDisplayName}" FontSize="12" Foreground="{StaticResource TextOnDarkMutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            <Border Height="1" Background="{StaticResource SidebarDividerBrush}" Margin="0,14,0,10" />
                        </StackPanel>

                        <Button DockPanel.Dock="Bottom" Content="🚪  Вийти з акаунта" Command="{Binding LogoutCommand}" Style="{StaticResource NavButtonStyle}" Foreground="#FF8A8A" Margin="0,10,0,0" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel>
                                <RadioButton Content="📊  Дашборд" Command="{Binding NavigateDashboardCommand}" 
                                             IsChecked="{Binding IsDashboardActive, Mode=OneWay}" GroupName="SidebarMenu" Style="{StaticResource NavRadioButtonStyle}" />

                                <RadioButton Content="📚  Каталог" Command="{Binding NavigateCatalogCommand}" 
                                             IsChecked="{Binding IsCatalogActive, Mode=OneWay}" GroupName="SidebarMenu" Style="{StaticResource NavRadioButtonStyle}" />

                                <RadioButton Content="📅  Генератор меню" Command="{Binding NavigatePlanGeneratorCommand}" 
                                             IsChecked="{Binding IsPlanGeneratorActive, Mode=OneWay}" GroupName="SidebarMenu" Style="{StaticResource NavRadioButtonStyle}" />

                                <RadioButton Content="👤  Профіль" Command="{Binding NavigateProfileCommand}" 
                                             IsChecked="{Binding IsProfileActive, Mode=OneWay}" GroupName="SidebarMenu" Style="{StaticResource NavRadioButtonStyle}" />

                                <RadioButton Content="📈  Статистика" Command="{Binding NavigateStatisticsCommand}" 
                                             IsChecked="{Binding IsStatisticsActive, Mode=OneWay}" 
                                             GroupName="SidebarMenu" Style="{StaticResource NavRadioButtonStyle}" />
                                
                                <RadioButton Content="↺  Історія дій" Command="{Binding NavigateUndoHistoryCommand}" 
                                             IsChecked="{Binding IsUndoHistoryActive, Mode=OneWay}" GroupName="SidebarMenu" Style="{StaticResource NavRadioButtonStyle}" />

                                <RadioButton Content="⚙️  Адмін-панель" Command="{Binding NavigateAdminCommand}" 
                                             Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" 
                                             IsChecked="{Binding IsAdminActive, Mode=OneWay}" GroupName="SidebarMenu" 
                                             Style="{StaticResource NavRadioButtonStyle}" Foreground="#FBBF24" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Main Frame -->
                <Grid Grid.Column="1">
                    <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>