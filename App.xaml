<Application x:Class="DietPlanner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:DietPlanner.Common">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
                <ResourceDictionary Source="Resources/Strings.uk-UA.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <common:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <common:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
            <common:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <common:NullableDateTimeToDateTimeOffsetConverter x:Key="NullableDateTimeToDateTimeOffsetConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>